# Dhan Data API (needed only for `npm run fetch-data`; the app runs on the files in public/data)
DHAN_CLIENT_ID=
# Automatic tokens (recommended): turn on TOTP at web.dhan.co → My Profile → DhanHQ Trading APIs → Setup TOTP,
# and put the secret key shown with the QR code here. A fresh 24 h token is then made whenever one is needed.
# Anyone with these two can log in to your account: keep this file private.
DHAN_PIN=
DHAN_TOTP_SECRET=
# Or paste a token from web.dhan.co by hand (expires after 24 hours). Used while it's valid.
DHAN_ACCESS_TOKEN=
