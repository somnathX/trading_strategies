{
  "name": "orb-backtester",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "fetch-data": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/fetch-data.ts",
    "fetch-us": "node --disable-warning=ExperimentalWarning scripts/fetch-us.ts",
    "fetch-options": "node --disable-warning=ExperimentalWarning scripts/fetch-options.ts",
    "build:bot": "vite build --ssr src/bot/bot.ts --outDir bot-dist --emptyOutDir",
    "bot": "node --env-file-if-exists=.env bot-dist/bot.js"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "klinecharts": "^10.1.0",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.73.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^3.2.7"
  }
}
